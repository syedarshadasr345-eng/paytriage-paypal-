# ==============================================================================
# PayTriage — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
SECRET_KEY=replace_with_a_secure_random_string_min_32_chars
SESSION_SECRET=replace_with_a_secure_session_secret_min_32_chars_2026
DEMO_USER=merchant@example.com
DEMO_PASSWORD=paytriage2026
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./data/paytriage.db

# PayPal Sandbox Credentials (developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI Provider Configuration
# Supported options: 'gemini' | 'openai'
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=your_openai_api_key_here

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration (used by Vite)
VITE_API_URL=http://localhost:8000
