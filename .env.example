# ==============================================================================
# InvoicePilot AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
SECRET_KEY=replace_with_a_secure_random_string_min_32_chars
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./data/invoicepilot.db

# PayPal Sandbox Credentials (developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI Provider Configuration
# Supported options: 'gemini' | 'openai'
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration (used by Vite)
VITE_API_URL=http://localhost:8000
